# Default deny: local control-plane and generated files stay local.
*

# Permit traversal so explicit file exceptions can match.
!*/

# Published repository-policy exception.
!/.gitignore

# Published product documentation.
!/README.md
!/**/README.md

# Published SWI-Prolog product and test source.
!/src/**/*.pl
!/tests/**/*.pl

# The Codex/control plane is never published, including its README files.
/.codex/
/.agents/
/.vscode/
/.github/
/bootstrap/
/config/
/tasks/
/scripts/
/prompts/
/workflows/
/docs/plans/

# Root operational documents are local even if renamed later.
/AGENTS.md
/PLANS.md
/ROBOT.md
/CONTRIBUTING.md
/ROADMAP.md
/STATUS.md
/DECISIONS_NEEDED.md

# Primary evidence stays local; only its descriptive README may be published.
/references/*
!/references/README.md

# Generated and machine-local outputs never enter the product plane.
/artifacts/
/coverage/
/generated/
/results/
/.cache/
**/__pycache__/
*.log
*.pyc
